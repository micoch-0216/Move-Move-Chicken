<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <ImageView
        android:id="@+id/slowrunContentImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/workout_screen_desc"
        app:srcCompat="@drawable/slowrun_screen" />

    <!-- 左初級(藍)／中中級／右高級：透明圓可點擊，對齊圖中三圓大小與位置 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="112dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/btnBeginner"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="20dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btnIntermediate"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="20dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btnAdvanced"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 左上角返回：顯示箭頭，點擊返回運動頁（沿用原本返回、不另加黑色按鈕） -->
    <TextView
        android:id="@+id/slowrunBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="←"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:clickable="true"
        android:focusable="true" />

    <!-- 中間灰色框（含相機圖示）：點擊整塊區域開啟前鏡頭，底部留空不擋住導覽圖示 -->
    <View
        android:id="@+id/slowrunCameraIcon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="220dp"
        android:layout_marginBottom="116dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/camera_open_front"
        android:focusable="true" />

    <!-- 中下方房子：點擊回到首頁 -->
    <View
        android:id="@+id/slowrunNavHome"
        android:layout_width="80dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
